<Project Sdk="Microsoft.NET.Sdk">

  <!-- Claupet, la misma app en Windows, Linux y macOS: Core/ (lo que no es interfaz), Claupet Console (Console/) y
       la interfaz de la bandeja, la mascota y la isla (esta carpeta). Lo de cada sistema va con OperatingSystem.Is…(). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Claupet</AssemblyName>
    <RootNamespace>Claupet</RootNamespace>
    <Version>2.6.3</Version>
    <AssemblyTitle>Claupet</AssemblyTitle>
    <Product>Claupet</Product>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PortaPtyStageConPtyHost>false</PortaPtyStageConPtyHost>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Claupet Console es la misma en los tres sistemas. -->
    <Compile Include="..\Console\**\*.cs" Link="Console\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Las traducciones (L.T), dentro del ejecutable. -->
    <EmbeddedResource Include="..\Core\Idiomas\*.json" LogicalName="idiomas/%(Filename)%(Extension)" />
    <!-- El recolector de basura que ahorra memoria: compacta más seguido, y la app (que vive todo el día en la bandeja)
         queda en unos 180 MB en vez de unos 500. El concurrente sigue encendido, para que las animaciones no se traben. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <!-- Los términos y condiciones del asistente (Terms), en cada idioma. -->
    <EmbeddedResource Include="..\Core\Terminos\*.txt" LogicalName="terminos/%(Filename)%(Extension)" />
    <!-- Las skills de Claude Code que trae Claupet (ClaudeSkills): se instalan desde Ajustes › Skills. -->
    <EmbeddedResource Include="..\Core\Skills\*\SKILL.md" LogicalName="skills/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Los paquetes de Contratos Claupet que vienen dentro del motor (los mismos que lleva cpt). -->
    <EmbeddedResource Include="..\Core\Contratos\Paquetes\**\*.md" LogicalName="contratos/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Las pruebas (Claupet.Tests) ven lo interno de la app. -->
    <InternalsVisibleTo Include="Claupet.Tests" />
  </ItemGroup>

  <!-- En Linux, .NET necesita ICU para las fechas en español y no todas las distribuciones la traen:
       la app lleva la suya. Windows y macOS ya la tienen. -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <!-- SQLite (Core/Db.cs) con la biblioteca que ya trae cada sistema (winsqlite3, libsqlite3): sin binarios nativos en
         el paquete. Hoy lee la base de OpenCode; luego, métricas e índices de Claupet. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.provider.dynamic_cdecl" Version="2.1.13" />
    <!-- La pantalla completa de los shells de Claupet Terminal (vim, less, claude…): interpreta las secuencias VT. -->
    <PackageReference Include="XTerm.NET" Version="3.0.0" />
    <!-- Los .md de la vista de archivos de Claupet Terminal, dibujados como documento (títulos, listas, tablas…). -->
    <PackageReference Include="Markdig" Version="1.4.1" />
    <!-- En Windows, las secciones HTML y SVG de Claupet Canvas se ven vivas dentro del panel (CanvasLivePage): el motor
         de Edge (WebView2), que trae Windows. En Linux y macOS no se usa: ahí siguen con el botón del navegador. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />    <!-- Los shells de Claupet Terminal en Linux y macOS: una pty abierta por su ayudante nativo (en Windows va la ConPTY
         propia, Core/PseudoConsole.cs). Su ConPTY de Windows no se usa: ni conpty.dll ni OpenConsole.exe en el paquete. -->
    <PackageReference Include="Porta.Pty" Version="2.2.3" />
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.24.260710001" ExcludeAssets="all" />
    <!-- En Windows, avisa al desbloquear, al volver de suspender y al cambiar las pantallas (la mascota vuelve a verse). -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.14" />
    <!-- La voz: Whisper (voz a texto), Supertonic con ONNX Runtime (texto a voz) y PortAudio (el micrófono y los
         parlantes), con sus bibliotecas nativas para Windows, Linux y macOS. System.Speech solo sirve en Windows. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <PackageReference Include="System.Speech" Version="10.0.14" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <!-- De WebView2 solo se usa el núcleo (Core): sus controles de WPF y WinForms no van (y el de WPF choca con WindowsBase). -->
  <Target Name="WebView2SoloNucleo" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

</Project>
