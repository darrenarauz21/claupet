<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <AssemblyName>Claupet</AssemblyName>
    <RootNamespace>Claupet</RootNamespace>
    <Version>2.3.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>Claupet</AssemblyTitle>
    <Product>Claupet</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- La app de Linux y macOS tiene su propio proyecto; aquí solo entra Core/. -->
    <Compile Remove="Claupet.Avalonia/**" />
    <None Remove="Claupet.Avalonia/**" />
    <EmbeddedResource Remove="Claupet.Avalonia/**" />
    <!-- Las pruebas tienen su propio proyecto (Claupet.Tests), que ve lo interno de la app. -->
    <Compile Remove="Claupet.Tests/**" />
    <None Remove="Claupet.Tests/**" />
    <EmbeddedResource Remove="Claupet.Tests/**" />
    <InternalsVisibleTo Include="Claupet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Las traducciones (L.T), dentro del ejecutable. -->
    <EmbeddedResource Include="Core/Idiomas/*.json" LogicalName="idiomas/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- Claupet Console (Console/): solo la carga el proceso de la ventana grande (con la opción «console»). -->
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

</Project>
